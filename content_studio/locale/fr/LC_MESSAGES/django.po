#: templates/content_studio/users/email_changed.txt:1
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"The email address of your account for %(site_title)s was changed from %(email)s to another address. Password links and notifications now go to the new address."
msgstr ""
"Bonjour %(name)s,\n"
"\n"
"L’adresse e-mail de votre compte pour %(site_title)s a été changée de %(email)s en une autre adresse. Les liens de mot de passe et les notifications sont désormais envoyés à la nouvelle adresse."

