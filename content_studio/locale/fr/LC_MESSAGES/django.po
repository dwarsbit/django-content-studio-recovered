msgid "If you did not change it, contact your administrator right away."
msgstr ""
"Si vous ne l’avez pas modifiée, contactez immédiatement votre "
"administrateur."

#: templates/content_studio/users/invite.txt:1
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"%(sender)s invited you to %(site_title)s. Set your password to log in:"
msgstr ""
"Bonjour %(name)s,\n"
"\n"
"%(sender)s vous a invité sur %(site_title)s. Définissez votre mot de passe pour vous connecter :"

#: templates/content_studio/users/invite.txt:7
#, python-format
msgid ""
"Your username is %(username)s. The link works once and expires in "
"%(expires)s. If it has expired, ask %(sender)s for a new one."
msgstr ""
"Votre nom d’utilisateur est %(username)s. Le lien ne fonctionne qu’une fois "
"et expire dans %(expires)s. S’il a expiré, demandez-en un nouveau à "
"%(sender)s."

