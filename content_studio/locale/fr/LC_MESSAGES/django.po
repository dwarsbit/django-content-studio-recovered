#: templates/content_studio/users/two_factor_reset.txt:1
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"%(sender)s reset your two-factor login for %(site_title)s. You log in with your password alone now, and your old recovery codes no longer work. If two-factor login is required, you set it up again the next time you log in."
msgstr ""
"Bonjour %(name)s,\n"
"\n"
"%(sender)s a réinitialisé votre connexion à deux facteurs pour %(site_title)s. Vous vous connectez désormais avec votre seul mot de passe, et vos anciens codes de récupération ne fonctionnent plus. Si la connexion à deux facteurs est obligatoire, vous la configurerez de nouveau à votre prochaine connexion."

#: templates/content_studio/users/two_factor_reset.txt:5
msgid "If you did not ask for this, contact your administrator."
msgstr ""
"Si vous n’êtes pas à l’origine de cette demande, contactez votre "
"administrateur."

