msgid "If you did not change it, contact your administrator right away."
msgstr ""
"Si no la has cambiado tú, ponte en contacto con tu administrador de "
"inmediato."

#: templates/content_studio/users/invite.txt:1
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"%(sender)s invited you to %(site_title)s. Set your password to log in:"
msgstr ""
"Hola, %(name)s:\n"
"\n"
"%(sender)s le ha invitado a %(site_title)s. Establezca su contraseña para "
"iniciar sesión:"

#: templates/content_studio/users/invite.txt:7
#, python-format
msgid ""
"Your username is %(username)s. The link works once and expires in "
"%(expires)s. If it has expired, ask %(sender)s for a new one."
msgstr ""
"Su nombre de usuario es %(username)s. El enlace funciona una sola vez y "
"caduca en %(expires)s. Si ha caducado, pida uno nuevo a %(sender)s."

#: templates/content_studio/users/password_link.txt:1
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"%(sender)s sent you a link to set a new password for %(site_title)s:"
msgstr ""
"Hola, %(name)s:\n"
"\n"
"%(sender)s le ha enviado un enlace para establecer una nueva contraseña para "
"%(site_title)s:"

#: templates/content_studio/users/password_link.txt:7
#, python-format
msgid ""
"Your username is %(username)s. The link works once and expires in "
"%(expires)s. If you did not expect this email, contact your administrator."
msgstr ""
"Su nombre de usuario es %(username)s. El enlace funciona una sola vez y "
"caduca en %(expires)s. Si no esperaba este correo, póngase en contacto con "
"su administrador."

#: templates/content_studio/users/two_factor_reset.txt:1
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"%(sender)s reset your two-factor login for %(site_title)s. You log in with "
"your password alone now, and your old recovery codes no longer work. If two-"
"factor login is required, you set it up again the next time you log in."
msgstr ""
"Hola, %(name)s:\n"
"\n"
"%(sender)s ha restablecido su inicio de sesión en dos pasos de "
"%(site_title)s. Ahora inicia sesión solo con su contraseña, y sus códigos de "
"recuperación anteriores ya no funcionan. Si el inicio de sesión en dos pasos "
"es obligatorio, lo configurará de nuevo la próxima vez que inicie sesión."

#: templates/content_studio/users/two_factor_reset.txt:5
msgid "If you did not ask for this, contact your administrator."
msgstr "Si no lo ha pedido usted, póngase en contacto con su administrador."

