#: templates/content_studio/users/email_changed.txt:1
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"The email address of your account for %(site_title)s was changed from "
"%(email)s to another address. Password links and notifications now go to the "
"new address."
msgstr ""
"Hola, %(name)s:\n"
"\n"
"La dirección de correo de tu cuenta de %(site_title)s se ha cambiado de "
"%(email)s a otra dirección. Los enlaces de contraseña y las notificaciones "
"irán ahora a la nueva dirección."

